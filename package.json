{
  "name": "dispatch",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "start": "bun run src/main.ts",
    "dev": "bun --watch run src/main.ts",
    "test": "bun test",
    "test:ci": "bun test --coverage-reporter=lcov",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src/",
    "build": "bun build --compile src/main.ts --outfile dispatch --external @x402/fetch"
  },
  "dependencies": {
    "agentmail": "^0.3.7",
    "@anthropic-ai/claude-agent-sdk": "^0.1.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.7",
    "@types/bun": "latest",
    "typescript": "^5.5.0"
  }
}
